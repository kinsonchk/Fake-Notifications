{"diagram":"ClassDiagram","nodes":[{"name":"How a tapped notification is classified (NotificationClassifier.assess).\nQuestions are checked top to bottom; the first Yes wins.\nThe rule code is saved as TapRecord.rule.","x":40,"y":10,"id":0,"type":"NoteNode"},{"name":"Receive notification\n(details cached by key)","x":40,"y":80,"id":1,"type":"InterfaceNode","methods":""},{"name":"Tapped?\n(removal reason = REASON_CLICK)","x":40,"y":180,"id":2,"type":"ClassNode","methods":"","attributes":""},{"name":"NOT A TAP","x":400,"y":180,"id":3,"type":"ClassNode","methods":"","attributes":"swipe / clear all: stats only\nanything else: ignored"},{"name":"Is the package whitelisted?","x":40,"y":280,"id":4,"type":"ClassNode","methods":"","attributes":""},{"name":"IMPORTANT","x":400,"y":280,"id":5,"type":"ClassNode","methods":"","attributes":"rule: whitelisted"},{"name":"Category in [call, alarm,\nreminder, event]?","x":40,"y":380,"id":6,"type":"ClassNode","methods":"","attributes":""},{"name":"IMPORTANT","x":400,"y":380,"id":7,"type":"ClassNode","methods":"","attributes":"rule: important_category"},{"name":"Title contains a VIP name?","x":40,"y":480,"id":8,"type":"ClassNode","methods":"","attributes":""},{"name":"IMPORTANT","x":400,"y":480,"id":9,"type":"ClassNode","methods":"","attributes":"rule: vip_title"},{"name":"Title or text contains\nan important keyword?","x":40,"y":580,"id":10,"type":"ClassNode","methods":"","attributes":""},{"name":"IMPORTANT","x":400,"y":580,"id":11,"type":"ClassNode","methods":"","attributes":"rule: important_keyword"},{"name":"Channel marked important\nfor this app?","x":40,"y":680,"id":12,"type":"ClassNode","methods":"","attributes":""},{"name":"IMPORTANT","x":400,"y":680,"id":13,"type":"ClassNode","methods":"","attributes":"rule: important_channel"},{"name":"Discord profile and\na conversation?","x":40,"y":780,"id":14,"type":"ClassNode","methods":"","attributes":""},{"name":"IMPORTANT","x":400,"y":780,"id":15,"type":"ClassNode","methods":"","attribu